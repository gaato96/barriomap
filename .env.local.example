# ── Supabase ────────────────────────────────────────────────────────────────
# Copiá este archivo a `.env.local` y completá con tus valores reales.
# (Dashboard de Supabase -> Project Settings -> API)

# Project URL (ej. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (segura para el cliente, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key  ⚠️ SOLO SERVIDOR — nunca la expongas al cliente.
# Se usa para que el superadmin cree cuentas de dueños y para el seed.
SUPABASE_SERVICE_ROLE_KEY=
